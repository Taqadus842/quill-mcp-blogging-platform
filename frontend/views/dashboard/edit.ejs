<%- include('../partials/head', { title: 'Edit · ' + post.title }) %>

<div class="container-wide" style="padding-top: 40px;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap: 24px; flex-wrap: wrap;">
    <div style="flex: 1 1 520px; min-width: 320px;">
      <div style="margin-bottom: 12px;">
        <span class="pill pill-<%= post.status %>"><%= post.status %></span>
      </div>

      <%- include('../partials/flash', { notice: typeof notice !== 'undefined' ? notice : null, error: typeof error !== 'undefined' ? error : null }) %>

      <form method="POST" action="/dashboard/posts/<%= post.id %>">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required value="<%= post.title %>" />

        <label for="tags">Tags</label>
        <input type="text" id="tags" name="tags" value="<%= post.tags.join(', ') %>" />

        <label for="content">Content (Markdown)</label>
        <textarea id="content" name="content"><%= post.content_md %></textarea>

        <button type="submit" class="btn">Save changes</button>
      </form>

      <form method="POST" action="/dashboard/posts/<%= post.id %>/delete"
        onsubmit="return confirm('Delete this post permanently? This cannot be undone.');" style="margin-top: 10px;">
        <button type="submit" class="btn btn-danger btn-sm">Delete post</button>
      </form>
    </div>

    <div style="flex: 0 0 300px;">
      <div class="card">
        <h3>Publish</h3>
        <% if (post.status !== 'published') { %>
          <form method="POST" action="/dashboard/posts/<%= post.id %>/publish"
            onsubmit="return confirm('Publish this post now? It will go live immediately.');">
            <button type="submit" class="btn" style="width:100%; justify-content:center; margin-bottom:10px;">Publish now</button>
          </form>
        <% } else { %>
          <form method="POST" action="/dashboard/posts/<%= post.id %>/unpublish">
            <button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center; margin-bottom:10px;">Unpublish</button>
          </form>
        <% } %>

        <form method="POST" action="/dashboard/posts/<%= post.id %>/schedule">
          <label for="publish_at" style="margin-top: 6px;">Schedule for</label>
          <input type="datetime-local" id="publish_at" name="publish_at" />
          <button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center;">Schedule</button>
        </form>

        <% if (post.status === 'published' && post.published_at) { %>
          <p class="muted" style="margin-top:10px;">Published <%= new Date(post.published_at + 'Z').toLocaleString() %></p>
          <p class="muted"><a href="/<%= username %>/<%= post.slug %>" target="_blank">View live &rarr;</a></p>
        <% } %>
      </div>

      <div class="card">
        <h3>SEO</h3>
        <form method="POST" action="/dashboard/posts/<%= post.id %>/seo">
          <label for="meta_title">Meta title</label>
          <input type="text" id="meta_title" name="meta_title" value="<%= post.meta_title || '' %>" />

          <label for="meta_description">Meta description</label>
          <textarea id="meta_description" name="meta_description" style="min-height: 90px; font-family: var(--font-body); font-size: 0.9rem;"><%= post.meta_description || '' %></textarea>

          <label for="slug">Slug</label>
          <input type="text" id="slug" name="slug" value="<%= post.slug %>" />

          <button type="submit" class="btn btn-secondary" style="width:100%; justify-content:center;">Save SEO</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
