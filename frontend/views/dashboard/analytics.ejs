<%- include('../partials/head', { title: 'Analytics' }) %>

<div class="container-wide" style="padding-top: 40px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
    <h1 style="font-size:1.8rem; margin:0;">Analytics</h1>
    <div style="display:flex; gap:8px;">
      <a href="/dashboard/analytics?range=7d" class="btn btn-secondary btn-sm">7d</a>
      <a href="/dashboard/analytics?range=30d" class="btn btn-secondary btn-sm">30d</a>
      <a href="/dashboard/analytics?range=90d" class="btn btn-secondary btn-sm">90d</a>
      <a href="/dashboard/analytics?range=all" class="btn btn-secondary btn-sm">All time</a>
    </div>
  </div>

  <div class="card">
    <h3>Total views (<%= data.range %>)</h3>
    <p style="font-family: var(--font-mono); font-size: 2rem; color: var(--ink); margin: 0;"><%= data.total_views %></p>
  </div>

  <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 16px;">
    <div class="card">
      <h3>Top posts</h3>
      <% if (data.top_posts.length === 0) { %>
        <p class="muted">No views yet in this range.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Post</th><th>Views</th></tr></thead>
          <tbody>
            <% data.top_posts.forEach(function(p) { %>
              <tr><td><a href="/dashboard/posts/<%= p.post_id %>"><%= p.title %></a></td><td><%= p.views %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <div class="card">
      <h3>Top referrers</h3>
      <% if (data.top_referrers.length === 0) { %>
        <p class="muted">No referrer data yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Referrer</th><th>Views</th></tr></thead>
          <tbody>
            <% data.top_referrers.forEach(function(r) { %>
              <tr><td><%= r.referrer %></td><td><%= r.views %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
