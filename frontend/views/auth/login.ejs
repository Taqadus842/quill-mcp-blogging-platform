<%- include('../partials/head', { title: 'Log in' }) %>

<div class="container" style="padding-top: 48px; max-width: 440px;">
  <h1 style="font-size: 1.9rem;">Log in</h1>

  <%- include('../partials/flash', { error: typeof error !== 'undefined' ? error : null }) %>

  <form method="POST" action="/login">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required value="<%= typeof values !== 'undefined' ? values.email : '' %>" />

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required />

    <button type="submit" class="btn" style="width:100%; justify-content:center;">Log in</button>
  </form>
  <p class="muted" style="margin-top:16px;">No account yet? <a href="/signup">Sign up</a></p>
</div>

<%- include('../partials/foot') %>
