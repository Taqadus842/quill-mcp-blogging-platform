<%- include('partials/head', { title: 'Quill — your blog, from your editor' }) %>

<div class="container-wide hero">
  <span class="kicker">quill</span>
  <h1>
    Your blog,<br>
    inside your editor.
  </h1>
  <div class="section" id="how">
