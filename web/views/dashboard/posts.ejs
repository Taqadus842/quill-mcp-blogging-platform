<%- include('../partials/head', { title: 'Posts' }) %>

<div class="container-wide" style="padding-top: 40px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
    <h1 style="font-size:1.8rem; margin:0;">Posts</h1>
    <a href="/dashboard/posts/new" class="btn">New post</a>
  </div>

  <%- include('../partials/flash', { notice: typeof notice !== 'undefined' ? notice : null, error: typeof error !== 'undefined' ? error : null }) %>

  <div style="display:flex; gap:8px; margin-bottom: 18px;">
    <a href="/dashboard" class="btn btn-secondary btn-sm <%= !status ? 'active' : '' %>">All</a>
    <a href="/dashboard?status=draft" class="btn btn-secondary btn-sm">Drafts</a>
    <a href="/dashboard?status=scheduled" class="btn btn-secondary btn-sm">Scheduled</a>
    <a href="/dashboard?status=published" class="btn btn-secondary btn-sm">Published</a>
  </div>

  <div class="card">
    <% if (posts.length === 0) { %>
      <div class="empty-state">
        <h3>No posts yet</h3>
        <p>Create one here, or ask your agent to draft one for you.</p>
        <a href="/dashboard/posts/new" class="btn" style="margin-top:8px;">New post</a>
      </div>
    <% } else { %>
      <% posts.forEach(function(p) { %>
        <div class="post-row">
          <div>
            <div class="post-title"><a href="/dashboard/posts/<%= p.id %>"><%= p.title %></a></div>
            <div class="post-meta">
              <span class="pill pill-<%= p.status %>"><%= p.status %></span>
              &nbsp;updated <%= new Date(p.updated_at + 'Z').toLocaleString() %>
              <% if (p.status === 'scheduled' && p.scheduled_at) { %>
                &middot; publishes <%= new Date(p.scheduled_at).toLocaleString() %>
              <% } %>
            </div>
          </div>
          <div style="display:flex; gap:8px;">
            <a href="/dashboard/posts/<%= p.id %>" class="btn btn-secondary btn-sm">Edit</a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<%- include('../partials/foot') %>
