<%- include('../partials/head', { title: 'Sign up' }) %>

<div class="container" style="padding-top: 48px; max-width: 440px;">
  <h1 style="font-size: 1.9rem;">Create your account</h1>
  <p class="muted">Signup creates both a dashboard login and a working MCP URL, in one step.</p>

  <%- include('../partials/flash', { error: typeof error !== 'undefined' ? error : null }) %>

  <form method="POST" action="/signup">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required value="<%= typeof values !== 'undefined' ? values.email : '' %>" />

    <label for="username">Username</label>
    <input type="text" id="username" name="username" required pattern="[a-zA-Z0-9\-]+" minlength="3" maxlength="32"
      value="<%= typeof values !== 'undefined' ? values.username : '' %>" />
    <div class="field-hint">Your public blog will live at /&lt;username&gt;. Letters, numbers, and hyphens only.</div>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required minlength="8" />
    <div class="field-hint">At least 8 characters.</div>

    <button type="submit" class="btn" style="width:100%; justify-content:center;">Create account</button>
  </form>
  <p class="muted" style="margin-top:16px;">Already have an account? <a href="/login">Log in</a></p>
</div>

<%- include('../partials/foot') %>
