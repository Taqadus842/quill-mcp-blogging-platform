<%- include('../partials/head', { title: username, metaDescription: 'Posts by ' + username }) %>

<div class="container" style="padding-top: 40px;">
  <h1><%= username %></h1>

  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <h3>No posts published yet</h3>
      <p>Check back soon.</p>
    </div>
  <% } else { %>
    <% posts.forEach(function(p) { %>
      <div class="post-row">
        <div>
          <div class="post-title"><a href="/<%= username %>/<%= p.slug %>"><%= p.title %></a></div>
          <div class="post-meta"><%= new Date(p.published_at + 'Z').toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/foot') %>
